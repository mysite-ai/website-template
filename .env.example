# Supabase (NEW `website-template` project — dedicated, separate from attribution-autopilot)
PUBLIC_SUPABASE_URL="https://<website-template-project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"

# Attribution Autopilot API (loyalty / QR / phone capture)
PUBLIC_ATTRIBUTION_API_BASE="https://attribution.mysite.cx/api"

# Mapbox — traffic-aware travel time (`/api/eta`).
#
# Optional. Without it the "travel time" feature still works, but falls back
# to a free-flow estimate that ignores traffic (it can be ~40% optimistic in
# rush hour). Set it to get durations that match what a guest sees in Maps.
#
# Server-only: no `PUBLIC_` prefix, because Astro inlines PUBLIC_* variables
# into the browser bundle. Never rename this to PUBLIC_MAPBOX_TOKEN.
#
# Creating the token (https://console.mapbox.com/account/access-tokens/):
#   - Needs NO scopes at all. The Directions API works with a default public
#     token; leave every secret scope unchecked.
#   - Do NOT add URL restrictions: those match on the browser `Referer`, and
#     this token is only ever used server-side, where there is none — the
#     restriction would block our own requests.
#   - Make it a dedicated token (e.g. "website-template-eta") rather than
#     reusing the default one, so its usage is visible separately in the
#     dashboard and it can be rotated on its own.
# MAPBOX_TOKEN=

# logo.dev — used only by scripts/download-delivery-logos.sh to
# pre-fetch delivery provider logos at build/onboarding time. Runtime
# never talks to logo.dev — the images are shipped statically from
# public/logos/delivery. Safe to commit (publishable key is designed
# to be exposed).
LOGO_DEV_PUBLISHABLE_KEY="pk_ELjo4KSSTHiRGwlaEzKpWQ"

# Optional. Only needed if you extend the site to call logo.dev's
# server-side REST APIs (Search / Brand). Never commit this.
# LOGO_DEV_SECRET_KEY=
