# Supabase (NEW `website-template` project — dedicated, separate from attribution-autopilot)
PUBLIC_SUPABASE_URL="https://<website-template-project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"

# Attribution Autopilot API (loyalty / QR / phone capture)
PUBLIC_ATTRIBUTION_API_BASE="https://attribution.mysite.cx/api"

# logo.dev — used only by scripts/download-delivery-logos.sh to
# pre-fetch delivery provider logos at build/onboarding time. Runtime
# never talks to logo.dev — the images are shipped statically from
# public/logos/delivery. Safe to commit (publishable key is designed
# to be exposed).
LOGO_DEV_PUBLISHABLE_KEY="pk_ELjo4KSSTHiRGwlaEzKpWQ"

# Optional. Only needed if you extend the site to call logo.dev's
# server-side REST APIs (Search / Brand). Never commit this.
# LOGO_DEV_SECRET_KEY=
