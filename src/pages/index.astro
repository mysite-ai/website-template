---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import QuickActions from "@/components/sections/QuickActions.astro";
import Gallery from "@/components/sections/Gallery.astro";
import Contact from "@/components/sections/Contact.astro";
import MenuPreview from "@/components/sections/MenuPreview.astro";
import About from "@/components/sections/About.astro";
import Delivery from "@/components/sections/Delivery.astro";
import { buildLocationSeo } from "@/lib/seo/schema";

const tenant = Astro.locals.tenant;
const seo = buildLocationSeo({ tenant, path: "/" });

Astro.response.headers.set(
  "cache-control",
  "public, s-maxage=60, stale-while-revalidate=300",
);
---

<BaseLayout tenant={tenant} seo={seo} currentPath="/">
  <Hero tenant={tenant} />
  <QuickActions tenant={tenant} />
  <Gallery tenant={tenant} />
  <Contact tenant={tenant} />
  <MenuPreview tenant={tenant} />
  <About tenant={tenant} />
  <Delivery tenant={tenant} />
</BaseLayout>
