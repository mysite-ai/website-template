---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MenuBrowser from "@/components/menu/MenuBrowser.tsx";
import { Card, CardContent } from "@/components/ui/card";
import { buildLocationSeo } from "@/lib/seo/schema";

const tenant = Astro.locals.tenant;
const seo = buildLocationSeo({
  tenant,
  path: "/menu",
  title: `Menu — ${tenant.brand.name}`,
});
const menu = tenant.location.menu;

Astro.response.headers.set(
  "cache-control",
  "public, s-maxage=60, stale-while-revalidate=300",
);
---

<BaseLayout tenant={tenant} seo={seo} currentPath="/menu">
  <section class="section-well pt-8 pb-2 lg:pt-12">
    <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
      {tenant.brand.name}
    </p>
    <h1 class="mt-2 text-[30px] font-semibold leading-tight tracking-tight sm:text-[34px] lg:text-[38px]">
      Menu
    </h1>
  </section>

  {menu && menu.categories.length > 0 ? (
    <section class="section-well mt-6 pb-16 lg:mt-8 lg:pb-20">
      <MenuBrowser client:visible menu={menu} />
    </section>
  ) : (
    <section class="section-well mt-6 pb-16">
      <Card>
        <CardContent className="py-10 text-center">
          <p class="text-sm text-muted-foreground">Menu coming soon — check back later.</p>
        </CardContent>
      </Card>
    </section>
  )}
</BaseLayout>
