---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MenuBrowser from "@/components/menu/MenuBrowser.tsx";
import { buildLocationSeo } from "@/lib/seo/schema";

const tenant = Astro.locals.tenant;
const seo = buildLocationSeo({
  tenant,
  path: "/menu",
  title: `Menu — ${tenant.brand.name}`,
});
const menu = tenant.location.menu;

Astro.response.headers.set(
  "cache-control",
  "public, s-maxage=60, stale-while-revalidate=300",
);
---

<BaseLayout tenant={tenant} seo={seo} currentPath="/menu">
  <section class="section-well pt-8 pb-4">
    <p class="section-label">{tenant.brand.name}</p>
    <h1 class="mt-1.5 text-[28px] font-semibold tracking-tight leading-tight">Menu</h1>
  </section>

  {menu && menu.categories.length > 0 ? (
    <section class="section-well mt-2 pb-16">
      <MenuBrowser client:visible menu={menu} />
    </section>
  ) : (
    <section class="section-well mt-4 pb-16">
      <div class="card p-8 text-center">
        <p class="text-sm text-muted-foreground">Menu coming soon — check back later.</p>
      </div>
    </section>
  )}
</BaseLayout>
