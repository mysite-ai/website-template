---
import "@/styles/globals.css";

Astro.response.status = 404;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — not found</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="min-h-screen grid place-items-center bg-background text-foreground">
    <div class="section-well text-center py-16">
      <p class="text-[80px] font-semibold tracking-tight leading-none">404</p>
      <p class="mt-4 text-[14px] text-muted-foreground max-w-xs mx-auto">
        We couldn't find that page. Check the URL, or head back to the home page.
      </p>
    </div>
  </body>
</html>
