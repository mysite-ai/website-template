---
import "@/styles/globals.css";

Astro.response.status = 404;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — nie znaleziono</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="min-h-screen grid place-items-center bg-background text-foreground">
    <div class="section-well text-center">
      <p class="text-6xl font-semibold tracking-tight">404</p>
      <p class="mt-3 text-sm text-muted-foreground">
        Nie znaleźliśmy tej strony. Sprawdź adres lub przejdź do strony głównej.
      </p>
    </div>
  </body>
</html>
