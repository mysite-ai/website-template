---
import "@/styles/globals.css";

Astro.response.status = 404;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>404 — not found</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="min-h-screen grid place-items-center bg-background text-foreground">
    <div class="section-well text-center py-16">
      <p class="text-[80px] font-semibold leading-none tracking-tight text-foreground/90">404</p>
      <p class="mx-auto mt-4 max-w-xs text-[14px] leading-relaxed text-muted-foreground">
        We couldn't find that page. Check the URL, or head back to the home page.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex h-9 items-center rounded-full bg-foreground px-4 text-[13px] font-medium text-background transition-opacity hover:opacity-90"
      >
        Back to home
      </a>
    </div>
  </body>
</html>
