---
import type { TenantContext } from "@/lib/tenant/types";

interface Props {
  tenant: TenantContext;
  currentPath: string;
}

const { tenant, currentPath } = Astro.props;
const { brand, location } = tenant;
const displayName = brand.slug === location.slug ? brand.name : `${brand.name} · ${location.name}`;

const links: Array<{ href: string; label: string }> = [
  { href: "/", label: "Home" },
  { href: "/menu", label: "Menu" },
  { href: "/promocja", label: "Rewards" },
];
---

<header class="sticky top-0 z-30 border-b border-border/50 bg-background/80 backdrop-blur-xl">
  <div class="section-well flex h-14 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label={displayName}>
      {brand.logo_url ? (
        <img src={brand.logo_url} alt="" class="h-7 w-7 object-contain" loading="eager" />
      ) : (
        <div class="h-7 w-7 rounded-lg bg-primary text-primary-foreground grid place-items-center text-[11px] font-semibold">
          {displayName.charAt(0)}
        </div>
      )}
      <span class="text-[13px] font-semibold tracking-tight">{displayName}</span>
    </a>

    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-0.5">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "px-3 py-1.5 text-[12px] font-medium rounded-full transition-colors",
                currentPath === link.href
                  ? "bg-primary text-primary-foreground"
                  : "text-muted-foreground hover:text-foreground hover:bg-muted",
              ]}
              aria-current={currentPath === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
