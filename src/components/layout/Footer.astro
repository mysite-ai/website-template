---
import type { TenantContext } from "@/lib/tenant/types";
import MysiteBadge from "./MysiteBadge.astro";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const { brand, location } = tenant;
const displayName = brand.slug === location.slug ? brand.name : `${brand.name} · ${location.name}`;
const year = new Date().getFullYear();
---

<footer class="section-well mt-16 pt-8 pb-10 text-center">
  {brand.logo_url && (
    <img
      src={brand.logo_url}
      alt={brand.name}
      class="w-14 h-14 mx-auto mb-4 object-contain opacity-75"
      loading="lazy"
      decoding="async"
    />
  )}
  <p class="text-[13px] text-muted-foreground">
    © {year} {displayName}
  </p>
  {location.address_line && (
    <p class="mt-1 text-[11px] text-muted-foreground/80">
      {[location.address_line, location.postal_code, location.city].filter(Boolean).join(", ")}
    </p>
  )}
  <MysiteBadge />
</footer>
