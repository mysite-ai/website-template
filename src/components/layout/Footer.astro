---
import type { TenantContext } from "@/lib/tenant/types";
import MysiteBadge from "./MysiteBadge.astro";
import { Instagram, Facebook } from "lucide-react";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const { brand, location } = tenant;
const displayName = brand.slug === location.slug ? brand.name : `${brand.name} · ${location.name}`;
const year = new Date().getFullYear();

interface Social {
  icon: typeof Instagram;
  label: string;
  href: string;
  umamiTarget: string;
}

const socials: Social[] = [
  location.instagram_url
    ? { icon: Instagram, label: "Instagram", href: location.instagram_url, umamiTarget: "instagram-footer" }
    : null,
  location.facebook_url
    ? { icon: Facebook, label: "Facebook", href: location.facebook_url, umamiTarget: "facebook-footer" }
    : null,
].filter((s): s is Social => s !== null);
---

<footer class="mt-16 lg:mt-20">
  <div class="h-px bg-gradient-to-r from-transparent via-foreground/10 to-transparent" aria-hidden="true"></div>

  <div class="section-well pt-10 pb-10 text-center">
    {socials.length > 0 && (
      <div class="mb-6 flex items-center justify-center gap-2">
        {socials.map((social) => {
          const Icon = social.icon;
          return (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-button"
              aria-label={social.label}
              data-umami-event="click-social"
              data-umami-event-target={social.umamiTarget}
            >
              <Icon size={18} strokeWidth={1.75} aria-hidden="true" />
            </a>
          );
        })}
      </div>
    )}

    {brand.logo_url && (
      <img
        src={brand.logo_url}
        alt={brand.name}
        class="mx-auto mb-4 h-16 w-16 object-contain opacity-90"
        loading="lazy"
        decoding="async"
      />
    )}

    <p class="text-[13px] font-medium tracking-tight text-foreground/90">
      {displayName}
    </p>
    {location.address_line && (
      <p class="mt-1 text-[12px] text-muted-foreground">
        {[location.address_line, location.postal_code, location.city].filter(Boolean).join(", ")}
      </p>
    )}
    <p class="mt-3 text-[11.5px] text-muted-foreground/80">
      © {year}
    </p>

    <MysiteBadge />
  </div>
</footer>
