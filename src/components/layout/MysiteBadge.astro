---
/*
 * Small "powered by mysite.ai" badge — every restaurant site ships
 * with this. Muted so it never competes with the tenant's own
 * branding.
 */
---

<a
  href="https://mysite.ai"
  target="_blank"
  rel="noopener noreferrer"
  class="mt-5 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10.5px] tracking-tight text-muted-foreground/70 transition-colors hover:bg-muted hover:text-foreground"
  data-umami-event="click-mysite-badge"
  data-umami-event-target="footer"
>
  <span>powered by</span>
  <span class="font-semibold text-foreground/90">mysite.ai</span>
</a>
