---
/*
 * Small "powered by mysite.ai" badge. Every restaurant site ships with
 * this — it's part of the deal. Keep it subtle.
 */
---

<a
  href="https://mysite.ai"
  target="_blank"
  rel="noopener noreferrer"
  class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-border/60 bg-background/70 px-3 py-1 text-[11px] text-muted-foreground backdrop-blur hover:text-foreground transition-colors"
>
  powered by <span class="font-semibold text-foreground">mysite.ai</span>
</a>
