---
import { Card } from "@/components/ui/card";
import type { TenantContext } from "@/lib/tenant/types";
import { ArrowRight } from "lucide-react";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const menu = tenant.location.menu;
const preview = menu?.categories.slice(0, 3) ?? [];
const totalItems = menu?.categories.reduce((acc, c) => acc + c.items.length, 0) ?? 0;
const showSection = preview.length > 0;
---

{showSection && (
  <section class="section-well mt-6 lg:mt-8">
    <div class="mb-3 flex items-baseline justify-between px-1">
      <h2 class="section-heading">Menu</h2>
      {totalItems > 0 && (
        <span class="text-[11.5px] text-muted-foreground tabular-nums">
          {totalItems} items
        </span>
      )}
    </div>

    <Card className="!p-0 gap-0">
      <ul class="divide-y divide-foreground/10">
        {preview.map((cat) => {
          const itemCount = cat.items.length;
          const first = cat.items[0];
          const second = cat.items[1];
          const line = [first?.name, second?.name].filter(Boolean).join(" · ");
          return (
            <li class="px-4 py-3.5">
              <div class="flex items-baseline justify-between gap-3">
                <p class="truncate text-[15px] font-semibold tracking-tight">{cat.name}</p>
                <span class="shrink-0 rounded-md bg-muted px-1.5 py-0.5 text-[10.5px] font-medium tabular-nums text-muted-foreground">
                  {itemCount}
                </span>
              </div>
              {line && (
                <p class="mt-0.5 line-clamp-1 text-[13px] text-muted-foreground">
                  {line}{itemCount > 2 ? ` · +${itemCount - 2} more` : ""}
                </p>
              )}
            </li>
          );
        })}
      </ul>
      <a
        href="/menu"
        class="group flex items-center justify-between border-t border-foreground/10 bg-muted/40 px-4 py-3.5 text-[14px] font-medium text-foreground transition-colors hover:bg-muted"
        data-umami-event="click-view-menu"
        data-umami-event-target="section-menu-preview"
      >
        <span>View full menu</span>
        <ArrowRight
          size={15}
          strokeWidth={1.75}
          aria-hidden="true"
          className="transition-transform group-hover:translate-x-0.5"
        />
      </a>
    </Card>
  </section>
)}
