---
import type { TenantContext } from "@/lib/tenant/types";
import { ArrowRight } from "lucide-react";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const menu = tenant.location.menu;
const preview = menu?.categories.slice(0, 3) ?? [];
const totalItems = menu?.categories.reduce((acc, c) => acc + c.items.length, 0) ?? 0;
const showSection = preview.length > 0;
---

{showSection && (
  <section class="section-well mt-10">
    <div class="mb-3 flex items-baseline justify-between px-1">
      <p class="section-label">Menu</p>
      {totalItems > 0 && (
        <span class="text-[11px] text-muted-foreground tabular-nums">{totalItems} items</span>
      )}
    </div>

    <div class="card overflow-hidden">
      <ul class="divide-y divide-border/40">
        {preview.map((cat) => {
          const itemCount = cat.items.length;
          const first = cat.items[0];
          const second = cat.items[1];
          const line = [first?.name, second?.name].filter(Boolean).join(" · ");
          return (
            <li class="px-5 py-3.5 sm:px-6">
              <div class="flex items-baseline justify-between gap-3">
                <p class="text-[15px] font-semibold tracking-tight truncate">{cat.name}</p>
                <span class="shrink-0 text-[11px] text-muted-foreground tabular-nums">
                  {itemCount}
                </span>
              </div>
              {line && (
                <p class="mt-0.5 text-[13px] text-muted-foreground line-clamp-1">
                  {line}{itemCount > 2 ? ` · +${itemCount - 2} more` : ""}
                </p>
              )}
            </li>
          );
        })}
      </ul>
      <a
        href="/menu"
        class="flex items-center justify-between border-t border-border/50 bg-muted/30 px-5 py-3.5 sm:px-6 text-[14px] font-semibold text-foreground hover:bg-muted transition-colors"
        data-umami-event="click-view-menu"
        data-umami-event-target="section-menu-preview"
      >
        <span>View full menu</span>
        <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
      </a>
    </div>
  </section>
)}
