---
import { Card } from "@/components/ui/card";
import type { TenantContext } from "@/lib/tenant/types";
import { ArrowUpRight } from "lucide-react";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const delivery = tenant.location.delivery;
---

{delivery.length > 0 && (
  <section class="section-well mt-6">
    <p class="section-label mb-3 px-1">Delivery</p>
    <Card className="p-0 gap-0">
      <ul class="divide-y divide-foreground/10">
        {delivery.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between px-4 py-3.5 text-[14px] font-medium hover:bg-muted/40 transition-colors"
              data-umami-event="click-delivery-provider"
              data-umami-event-target={link.name}
            >
              <span>{link.name}</span>
              <ArrowUpRight size={15} strokeWidth={1.75} className="text-muted-foreground" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </Card>
  </section>
)}
