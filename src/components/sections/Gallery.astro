---
import type { TenantContext } from "@/lib/tenant/types";
import GalleryBrowser from "./GalleryBrowser.tsx";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;

/*
 * Cap gallery to 8 photos on the homepage so a 4-col desktop grid
 * always fills two clean rows. lcm(2, 3, 4) = 12 but 8 reads better
 * as "portfolio" than a wall of thumbnails, and 8 = 2×4 (desktop),
 * 4×2 (mobile 2-col) which both fill cleanly.
 *
 * The section breaks out of `section-well` on desktop so the grid
 * can span up to ~1120px — matches the Kinoko pattern where the
 * gallery is the widest thing on the page.
 */
const gallery = tenant.location.gallery.slice(0, 8);
---

{gallery.length > 0 && (
  <section class="mt-10 lg:mt-16">
    <div class="section-well mb-4 lg:mb-6">
      <h2 class="section-heading px-1">Gallery</h2>
    </div>
    <div class="mx-auto w-full max-w-[70rem] px-5 sm:px-6 lg:px-8">
      <GalleryBrowser client:visible images={gallery} />
    </div>
  </section>
)}
