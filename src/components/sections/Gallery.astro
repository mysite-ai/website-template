---
import type { TenantContext } from "@/lib/tenant/types";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const gallery = tenant.location.gallery.slice(1, 7);
---

{gallery.length > 0 && (
  <section class="section-well mt-4">
    <div class="map-card p-5 sm:p-6">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Galeria</h2>
      <div class="mt-3 grid grid-cols-3 gap-2">
        {gallery.map((image) => (
          <img
            src={image.src}
            alt={image.alt}
            class="aspect-square w-full rounded-xl object-cover"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </div>
  </section>
)}
