---
import type { TenantContext } from "@/lib/tenant/types";
import { Instagram, Facebook } from "lucide-react";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const { location } = tenant;

interface Social {
  icon: typeof Instagram;
  label: string;
  href: string;
  umamiTarget: string;
}

const socials: Social[] = [
  location.instagram_url
    ? { icon: Instagram, label: "Instagram", href: location.instagram_url, umamiTarget: "instagram-hero" }
    : null,
  location.facebook_url
    ? { icon: Facebook, label: "Facebook", href: location.facebook_url, umamiTarget: "facebook-hero" }
    : null,
].filter((s): s is Social => s !== null);
---

{socials.length > 0 && (
  <section class="section-well mt-4 flex justify-center">
    <div class="flex items-center gap-2">
      {socials.map((social) => {
        const Icon = social.icon;
        return (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-button"
            aria-label={social.label}
            data-umami-event="click-social"
            data-umami-event-target={social.umamiTarget}
          >
            <Icon size={18} strokeWidth={1.75} aria-hidden="true" />
          </a>
        );
      })}
    </div>
  </section>
)}
