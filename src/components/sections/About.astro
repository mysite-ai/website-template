---
import type { TenantContext } from "@/lib/tenant/types";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const about = tenant.brand.about_md;
---

{about && (
  <section class="section-well mt-10">
    <p class="section-label mb-3 px-1">About</p>
    <div class="card p-5 sm:p-6">
      <div class="text-[14px] leading-relaxed whitespace-pre-line text-foreground/85">
        {about}
      </div>
    </div>
  </section>
)}
