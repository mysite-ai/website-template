---
import type { TenantContext } from "@/lib/tenant/types";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const about = tenant.brand.about_md;
---

{about && (
  <section class="section-well mt-4">
    <div class="map-card p-5 sm:p-6">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">About</h2>
      <div class="mt-3 text-sm leading-relaxed whitespace-pre-line text-foreground/90">
        {about}
      </div>
    </div>
  </section>
)}
