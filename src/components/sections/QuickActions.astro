---
import type { TenantContext, ActionTile, ActionTileType } from "@/lib/tenant/types";
import { formatPhone } from "@/lib/utils";
import { TILE_REGISTRY, FALLBACK_ICON, isExternalHref } from "@/lib/action-tiles/registry";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const { location } = tenant;

/*
 * QuickActions renders the operator-configured `action_tiles` row
 * below the Hero. Everything is driven from Supabase:
 *
 *   template_locations.action_tiles = [
 *     { "type": "directions", "href": "..." },
 *     { "type": "book",       "href": "...", "label": "Reserve at OpenTable" },
 *     { "type": "order",      "href": "...", "label": "Wolt" }
 *   ]
 *
 * When the column is NULL — typically for tenants that pre-date
 * migration 028 — we auto-derive a sensible default:
 *   - a Directions tile if maps_search_query is set
 *   - an Order tile if a delivery provider is configured
 *
 * That default matches what the site rendered before action_tiles
 * existed, so upgrading is invisible to operators.
 */

function buildFallback(): ActionTile[] {
  const tiles: ActionTile[] = [];
  if (location.maps_search_query) {
    tiles.push({
      type: "directions",
      href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.maps_search_query)}`,
    });
  }
  const firstDelivery = location.delivery[0];
  if (firstDelivery?.url) {
    tiles.push({
      type: "order",
      href: firstDelivery.url,
      label: firstDelivery.name,
    });
  }
  return tiles;
}

const tiles: ActionTile[] = location.action_tiles ?? buildFallback();

/*
 * Compute a human-readable sub-label per tile.
 *
 * We always show the tile's canonical `label` as the top line (either
 * the operator's override or the registry default). The sub-line is a
 * quick "where does this go" hint, distinct from the label:
 *
 *   - directions → the city name so the tile reads "Directions / Warsaw"
 *   - call       → the formatted phone if the href is `tel:`
 *   - email      → the email address if the href is `mailto:`
 *   - everything else → the host portion of the URL, which reads well
 *                       for links like `opentable.com`.
 *
 * Never show something that duplicates the top label — if the two
 * would collide, hide the sub-line.
 */
function subLabelFor(tile: ActionTile, topLabel: string): string | null {
  let candidate: string | null = null;
  switch (tile.type) {
    case "directions":
      candidate = location.city ?? null;
      break;
    case "call": {
      const raw = tile.href.replace(/^tel:/, "");
      candidate = raw ? formatPhone(raw) : null;
      break;
    }
    case "email":
      candidate = tile.href.replace(/^mailto:/, "") || null;
      break;
    default:
      try {
        candidate = new URL(tile.href).hostname.replace(/^www\./, "");
      } catch {
        candidate = null;
      }
  }
  if (!candidate) return null;
  if (candidate.toLowerCase() === topLabel.toLowerCase()) return null;
  return candidate;
}

interface Prepared {
  key: string;
  type: ActionTileType;
  label: string;
  sublabel: string | null;
  href: string;
  external: boolean;
  ariaLabel: string;
  umamiEvent: string;
  icon: typeof FALLBACK_ICON;
}

const prepared: Prepared[] = tiles.map((tile, i) => {
  const def = TILE_REGISTRY[tile.type];
  const label = tile.label?.trim() || def.defaultLabel;
  return {
    key: `${tile.type}-${i}`,
    type: tile.type,
    label,
    sublabel: subLabelFor(tile, label),
    href: tile.href,
    external: isExternalHref(tile.href),
    ariaLabel: label,
    umamiEvent: def.umamiEvent,
    icon: def.icon ?? FALLBACK_ICON,
  };
});
---

{prepared.length > 0 && (
  <section class="section-well mt-5 lg:mt-6">
    {/* Linktree-style link list. Full-width bars that span the whole
        content well (not a cramped narrow column), generously spaced so
        each one reads as a distinct, tappable button. Soft card surface,
        visible border and a gentle lift on hover keep it noticeable. */}
    <div class="flex w-full flex-col gap-3.5">
      {prepared.map((tile) => {
        const Icon = tile.icon;
        return (
          <a
            href={tile.href}
            aria-label={tile.ariaLabel}
            data-umami-event={tile.umamiEvent}
            data-umami-event-target="quick-actions"
            class="group flex w-full items-center justify-center gap-2.5 rounded-2xl border border-foreground/15 bg-card px-5 py-3 text-center shadow-[0_1px_2px_rgb(0_0_0/0.05),0_6px_18px_-12px_rgb(0_0_0/0.3)] transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:bg-primary/[0.05] hover:shadow-[0_2px_6px_rgb(0_0_0/0.07),0_12px_28px_-14px_rgb(0_0_0/0.4)] active:translate-y-0 active:scale-[0.99]"
            {...(tile.external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <Icon
              size={18}
              strokeWidth={2}
              aria-hidden="true"
              class="shrink-0 text-primary transition-transform duration-200 group-hover:scale-110"
            />
            <span class="min-w-0">
              <span class="block truncate text-[15px] font-semibold tracking-tight text-foreground">
                {tile.label}
              </span>
              {tile.sublabel && (
                <span class="block truncate text-[12px] font-medium text-muted-foreground">
                  {tile.sublabel}
                </span>
              )}
            </span>
          </a>
        );
      })}
    </div>
  </section>
)}
