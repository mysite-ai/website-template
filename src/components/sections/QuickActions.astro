---
import { Card, CardContent } from "@/components/ui/card";
import type { TenantContext } from "@/lib/tenant/types";
import { Navigation, ShoppingBag } from "lucide-react";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const { location } = tenant;

const directionsHref = location.maps_search_query
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.maps_search_query)}`
  : null;
const deliveryHref = location.delivery[0]?.url ?? null;

interface Tile {
  icon: typeof Navigation;
  label: string;
  sublabel: string;
  href: string;
  umamiEvent: string;
}

/*
 * Two primary next-step actions after the hero: "Go there" and "Get it
 * delivered". Calling is already covered by the phone button in the
 * header. Menu is covered by nav. If a tenant has neither directions
 * nor delivery configured, the section quietly disappears.
 */
const tilesRaw: (Tile | null)[] = [
  directionsHref
    ? {
        icon: Navigation,
        label: "Directions",
        sublabel: location.city ?? "Open in Maps",
        href: directionsHref,
        umamiEvent: "click-directions",
      }
    : null,
  deliveryHref
    ? {
        icon: ShoppingBag,
        label: "Order online",
        sublabel: location.delivery[0]?.name ?? "Delivery",
        href: deliveryHref,
        umamiEvent: "click-delivery",
      }
    : null,
];

const tiles = tilesRaw.filter((t): t is Tile => t !== null);
---

{tiles.length > 0 && (
  <section class="section-well mt-6 lg:mt-10">
    <div
      class:list={[
        "grid gap-3",
        tiles.length === 1 ? "grid-cols-1" : "grid-cols-2",
      ]}
    >
      {tiles.map((tile) => {
        const Icon = tile.icon;
        return (
          <a
            href={tile.href}
            aria-label={tile.label}
            data-umami-event={tile.umamiEvent}
            data-umami-event-target="quick-actions"
            target="_blank"
            rel="noopener noreferrer"
            class="group block transition-transform active:scale-[0.98]"
          >
            <Card className="transition-colors group-hover:bg-muted/60">
              <CardContent className="flex items-center gap-3 py-3.5">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-muted text-foreground/80 transition-colors group-hover:bg-background group-hover:text-foreground">
                  <Icon size={18} strokeWidth={1.75} aria-hidden="true" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[14px] font-semibold tracking-tight text-foreground">
                    {tile.label}
                  </span>
                  <span class="block truncate text-[12px] text-muted-foreground">
                    {tile.sublabel}
                  </span>
                </span>
              </CardContent>
            </Card>
          </a>
        );
      })}
    </div>
  </section>
)}
