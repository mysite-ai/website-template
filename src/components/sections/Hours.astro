---
import { Card, CardContent } from "@/components/ui/card";
import type { TenantContext } from "@/lib/tenant/types";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const { location } = tenant;
const weekday = location.weekday_hours;
const weekend = location.weekend_hours;
---

{(weekday || weekend) && (
  <section class="section-well mt-6 lg:mt-8">
    <Card>
      <CardContent>
        <div class="flex items-baseline justify-between">
          <p class="section-label">Hours</p>
          <span
            class="inline-flex items-center gap-1.5 text-[11px] font-medium text-muted-foreground"
            aria-hidden="true"
          >
            <span class="relative inline-flex h-1.5 w-1.5">
              <span class="absolute inset-0 rounded-full bg-emerald-500/70 motion-safe:animate-ping"></span>
              <span class="relative inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            </span>
            Open today
          </span>
        </div>
        <div class="mt-3 space-y-2 text-[14px]">
          {weekday && (
            <div class="flex items-baseline justify-between">
              <span class="text-muted-foreground">Mon – Fri</span>
              <span class="font-medium tabular-nums">{weekday}</span>
            </div>
          )}
          {weekend && (
            <div class="flex items-baseline justify-between">
              <span class="text-muted-foreground">Sat – Sun</span>
              <span class="font-medium tabular-nums">{weekend}</span>
            </div>
          )}
        </div>
      </CardContent>
    </Card>
  </section>
)}
