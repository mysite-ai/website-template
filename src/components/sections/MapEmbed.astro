---
import { Card, CardContent } from "@/components/ui/card";
import type { TenantContext } from "@/lib/tenant/types";
import { formatPhone } from "@/lib/utils";
import { Navigation, Phone } from "lucide-react";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const { location } = tenant;

const addressLine1 = location.address_line;
const addressLine2 = [location.postal_code, location.city].filter(Boolean).join(" ");
const phoneHref = location.phone ? `tel:${location.phone.replace(/\s+/g, "")}` : null;
const directionsHref = location.maps_search_query
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.maps_search_query)}`
  : null;
const shouldRender = addressLine1 || location.maps_embed_url;
---

{shouldRender && (
  <section id="location" class="section-well mt-6 scroll-mt-16">
    <p class="section-label mb-3 px-1">Location</p>
    <Card className="p-0 gap-0">
      {location.maps_embed_url && (
        <iframe
          src={location.maps_embed_url}
          title={`Map — ${location.name}`}
          class="w-full aspect-[16/9] border-0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        />
      )}

      <div class="p-4">
        <p class="text-[15px] font-semibold tracking-tight">{location.name}</p>
        {addressLine1 && (
          <p class="mt-0.5 text-[13px] text-muted-foreground">{addressLine1}</p>
        )}
        {addressLine2 && (
          <p class="text-[13px] text-muted-foreground">{addressLine2}</p>
        )}

        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          {directionsHref && (
            <a
              href={directionsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary text-primary-foreground text-[13px] font-medium py-2.5 hover:opacity-90 transition-opacity"
              data-umami-event="click-directions"
              data-umami-event-target="section-location"
            >
              <Navigation size={16} strokeWidth={1.75} aria-hidden="true" />
              Directions
            </a>
          )}
          {phoneHref && location.phone && (
            <a
              href={phoneHref}
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-card text-foreground text-[13px] font-medium py-2.5 ring-1 ring-foreground/10 hover:bg-muted transition-colors tabular-nums"
              data-umami-event="click-call"
              data-umami-event-target="section-location"
            >
              <Phone size={16} strokeWidth={1.75} aria-hidden="true" />
              {formatPhone(location.phone)}
            </a>
          )}
        </div>
      </div>
    </Card>
  </section>
)}
