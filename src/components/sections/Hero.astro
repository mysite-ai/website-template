---
import type { TenantContext } from "@/lib/tenant/types";
import PromoBanner from "@/components/promo/PromoBanner.tsx";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const { org, brand, location } = tenant;

const brandName = brand.name;
const locationLabel = [location.city, location.region].filter(Boolean).join(" · ");
const promoConfigured =
  !!location.attribution_promotion_id &&
  !!location.attribution_campaign_id &&
  !!location.attribution_org_id;
---

{brand.logo_url && <link rel="preload" as="image" href={brand.logo_url} />}

<section class="section-well pt-10 pb-6 sm:pt-12">
  <div class="text-center">
    {brand.logo_url ? (
      <img
        src={brand.logo_url}
        alt={brandName}
        class="w-20 h-20 sm:w-24 sm:h-24 mx-auto mb-6 object-contain"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-muted text-foreground grid place-items-center text-2xl font-semibold">
        {brandName.charAt(0)}
      </div>
    )}

    <h1 class="text-[28px] sm:text-[32px] font-semibold tracking-tight leading-tight">
      {brandName}
    </h1>

    {locationLabel && (
      <p class="mt-1.5 text-[13px] text-muted-foreground tracking-wide">
        {locationLabel}
      </p>
    )}

    {brand.tagline && (
      <p class="mt-4 text-[15px] text-muted-foreground leading-relaxed max-w-[26rem] mx-auto">
        {brand.tagline}
      </p>
    )}
  </div>

  {promoConfigured && (
    <div class="mt-7">
      <PromoBanner
        client:load
        href="/promocja"
        headline={location.promotion_name_cached ?? "Loyalty rewards"}
        subline={location.reward_description_cached ?? "Tap to reveal your personal QR code"}
        validUntilLabel="Ends {date}"
        expiredLabel="This promotion has ended"
        locale={org.default_locale ?? "en"}
      />
    </div>
  )}
</section>
