---
import type { TenantContext } from "@/lib/tenant/types";
import PromoBanner from "@/components/promo/PromoBanner.tsx";
import { Star, Globe } from "lucide-react";
import { withMysiteUtms } from "@/lib/utils";

interface Props {
  tenant: TenantContext;
}

const { tenant } = Astro.props;
const { brand, location } = tenant;

const brandName = brand.name;
const locationLabel = [location.city, location.region].filter(Boolean).join(" · ");
const promoConfigured =
  !!location.attribution_promotion_id &&
  !!location.attribution_campaign_id &&
  !!location.attribution_org_id;

const rating = location.google_rating;
const reviewCount = location.google_reviews_count;
const hasRating = rating !== null && rating !== undefined && reviewCount !== null && reviewCount > 0;
const ratingHref = location.google_place_url;

/*
 * Hero logo sizing.
 *
 * Assumes tenant logos are tight-cropped. With that assumption, one
 * standard size looks good on every tenant. The `logo_hero_max_height`
 * column is an escape hatch for the rare brand whose mark is
 * uncommonly tall or short even with a good crop — otherwise every
 * tenant leaves it NULL and inherits the standard.
 *
 * Standard (component defaults, used when null):
 *   - Desktop: 104 px max-height
 *   - Mobile:  83 px (auto-scaled 80%)
 *
 * Deliberately small: the hero's job is to drive taps on the promo CTA
 * and the action buttons, not to be a giant logo wall. The mark is a
 * quick brand signal above the name; the actions are the hierarchy.
 *
 * `object-contain` on the img preserves aspect ratio; wide wordmarks
 * end up shorter than max-height, tall marks fill it. The natural
 * width of the file drives horizontal size — no `max-width` here, so
 * files that were sloppily left with transparent side-padding will
 * look small (nudge the operator to re-crop, not to bump a column).
 */
const logoMaxHeightDesktop = brand.logo_hero_max_height ?? 104;
const logoMaxHeightMobile = Math.round(logoMaxHeightDesktop * 0.8);

/*
 * Promo urgency countdown. Opt-in per location: only pass a deadline
 * down to PromoBanner when the operator enabled the countdown AND the
 * deadline is still in the future. Anything else (disabled, null, or
 * already-past deadline) means "no countdown" — the banner degrades to
 * the plain CTA. Off for every tenant by default (see migration 030).
 */
const promoDeadline =
  location.promo_countdown_enabled &&
  location.promo_deadline &&
  new Date(location.promo_deadline).getTime() > Date.now()
    ? location.promo_deadline
    : null;

/*
 * Optional "fine print" condition line under the CTA (e.g. "Valid after
 * 2 PM only"). Opt-in per location: shown only when enabled and the text
 * is non-empty. Off for every tenant by default (see migration 032).
 */
const promoFinePrint =
  location.promo_fine_print_enabled && location.promo_fine_print?.trim()
    ? location.promo_fine_print.trim()
    : null;

/*
 * Optional "regular website" main button. Some tenants keep their own
 * site and we proxy it, so we surface a prominent button that links out
 * to their real domain — always tagged with MySite UTMs so the client
 * can see the referral in their own analytics. Hidden when unset.
 */
const websiteHref = location.website_url?.trim()
  ? withMysiteUtms(location.website_url.trim(), tenant.primaryHostname)
  : null;
---

{brand.logo_url && <link rel="preload" as="image" href={brand.logo_url} />}

{/* Full-bleed hero band with soft brand tint. On desktop this becomes the
    canvas that makes the page feel like a real landing page rather than a
    phone screen dropped into whitespace. */}
<section
  class="relative overflow-hidden pb-6 pt-7 sm:pt-8 lg:pb-10 lg:pt-12"
  style="background: radial-gradient(60% 65% at 50% 0%, color-mix(in oklab, var(--primary) 8%, transparent) 0%, transparent 70%), linear-gradient(180deg, color-mix(in oklab, var(--primary) 3%, var(--background)) 0%, var(--background) 100%);"
>
  <div class="section-well">
    <div class="text-center">
      {brand.logo_url ? (
        <img
          src={brand.logo_url}
          alt={brandName}
          class="hero-logo fade-rise mx-auto mb-4 w-auto max-w-[60%] object-contain lg:max-w-[45%]"
          style={`max-height:${logoMaxHeightMobile}px;--hero-logo-max-h-desktop:${logoMaxHeightDesktop}px`}
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <div class="fade-rise mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-muted text-2xl font-semibold text-foreground/70 ring-1 ring-foreground/10">
          {brandName.charAt(0)}
        </div>
      )}

      <h1 class="fade-rise fade-rise-delay-1 text-[30px] font-semibold leading-[1.05] tracking-tight sm:text-[38px] lg:text-[52px]">
        {brandName}
      </h1>

      {locationLabel && (
        <p class="fade-rise fade-rise-delay-2 mt-2 text-[12px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
          {locationLabel}
        </p>
      )}

      {hasRating && (
        <div class="fade-rise fade-rise-delay-2 mt-4">
          {ratingHref ? (
            <a
              href={ratingHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-full bg-card px-3 py-1.5 text-[13px] font-medium text-foreground ring-1 ring-foreground/10 shadow-sm transition-shadow hover:shadow-md"
              aria-label={`${rating} stars from ${reviewCount} Google reviews`}
              data-umami-event="click-google-reviews"
              data-umami-event-target="hero"
            >
              <span class="tabular-nums">{rating!.toFixed(1)}</span>
              <span class="inline-flex items-center gap-px" aria-hidden="true">
                {[0, 1, 2, 3, 4].map((i) => (
                  <Star
                    size={12}
                    strokeWidth={0}
                    fill={i < Math.round(rating!) ? "#f5b301" : "#e6e6e6"}
                    aria-hidden="true"
                  />
                ))}
              </span>
              <span class="text-muted-foreground">·</span>
              <span class="tabular-nums text-muted-foreground">
                {reviewCount!.toLocaleString()} reviews
              </span>
            </a>
          ) : (
            <div class="inline-flex items-center gap-1.5 rounded-full bg-card px-3 py-1.5 text-[13px] font-medium text-foreground ring-1 ring-foreground/10 shadow-sm">
              <span class="tabular-nums">{rating!.toFixed(1)}</span>
              <span class="inline-flex items-center gap-px" aria-hidden="true">
                {[0, 1, 2, 3, 4].map((i) => (
                  <Star
                    size={12}
                    strokeWidth={0}
                    fill={i < Math.round(rating!) ? "#f5b301" : "#e6e6e6"}
                    aria-hidden="true"
                  />
                ))}
              </span>
              <span class="text-muted-foreground">·</span>
              <span class="tabular-nums text-muted-foreground">
                {reviewCount!.toLocaleString()} reviews
              </span>
            </div>
          )}
        </div>
      )}

      {brand.tagline && (
        <p class="fade-rise fade-rise-delay-2 mx-auto mt-5 max-w-[30rem] text-[15px] leading-relaxed text-muted-foreground lg:mt-6 lg:text-[17px]">
          {brand.tagline}
        </p>
      )}
    </div>

    {promoConfigured && (
      <div class="fade-rise fade-rise-delay-3 mt-8 w-full lg:mt-10">
        <PromoBanner
          client:load
          href="/rewards"
          headline={location.reward_description_cached ?? location.promotion_name_cached ?? "Get your reward"}
          subline="Then show it at the counter to claim"
          deadline={promoDeadline}
          finePrint={promoFinePrint}
        />
      </div>
    )}

    {websiteHref && (
      <div class="fade-rise fade-rise-delay-3 mx-auto mt-6 w-full lg:mt-8">
        <a
          href={websiteHref}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex w-full items-center justify-center gap-2.5 rounded-2xl bg-primary px-6 py-4 text-[16px] font-semibold text-primary-foreground shadow-lg shadow-primary/20 ring-1 ring-inset ring-primary-foreground/10 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/25 active:translate-y-0"
          data-umami-event="click-website"
          data-umami-event-target="hero"
        >
          <Globe size={20} strokeWidth={2} aria-hidden="true" className="shrink-0" />
          Visit our website
        </a>
      </div>
    )}
  </div>
</section>

<style
  set:html={`
    /* Desktop-only override: the hero logo grows to its full
     * tenant-configured max-height on wide screens. Custom property
     * is set inline per tenant. */
    @media (min-width: 1024px) {
      .hero-logo { max-height: var(--hero-logo-max-h-desktop) !important; }
    }
  `}
/>
